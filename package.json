{
  "name": "fieldproof",
  "version": "0.1.0",
  "description": "Describe where every value on a screen comes from in JSON. Generates a field-by-field review tool and an LLM-readable map.",
  "keywords": [
    "field-map",
    "verification",
    "qa",
    "acceptance",
    "api",
    "documentation",
    "cli"
  ],
  "license": "MIT",
  "author": "Jason Lin <zhengdelin0720@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jasonlin0720/fieldproof.git"
  },
  "bugs": {
    "url": "https://github.com/jasonlin0720/fieldproof/issues"
  },
  "homepage": "https://github.com/jasonlin0720/fieldproof#readme",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "fieldproof": "./dist/cli.js"
  },
  "files": [
    "dist",
    "skills",
    "docs",
    "CHANGELOG.md",
    "AGENTS.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"fs.cpSync('src/assets','dist/assets',{recursive:true})\"",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "prepublishOnly": "pnpm build",
    "example": "tsx src/cli.ts build --config examples/fieldproof.config.json",
    "check": "pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "happy-dom": "^20.11.6",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
