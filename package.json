{
  "name": "fieldproof",
  "version": "0.1.0",
  "description": "把「畫面上每個欄位的值從哪來、怎麼算、該怎麼顯示」寫成 JSON，產出逐欄位驗收的 HTML 與供 LLM 讀的 Markdown",
  "keywords": [
    "field-map",
    "verification",
    "qa",
    "acceptance",
    "api",
    "documentation",
    "cli"
  ],
  "license": "MIT",
  "author": "Jason Lin <zhengdelin0720@gmail.com>",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "fieldproof": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && cp -R src/assets dist/assets",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "prepublishOnly": "pnpm build",
    "example": "tsx src/cli.ts build --config examples/fieldproof.config.json"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
